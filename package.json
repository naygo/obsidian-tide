    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
